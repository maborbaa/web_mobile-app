# Copie este arquivo para ".env" e preencha. O arquivo ".env" NÃO vai para o GitHub.
# Chaves geradas na Loja de APIs da AgroAPI: Applications > sua aplicação > Production Keys (ou Sandbox Keys).
AGROAPI_KEY=
AGROAPI_SECRET=

# Opcional: endereços usados pelo script de teste.
# Confira os valores corretos na aba Production Keys e no API Console da Loja de APIs.
# AGROAPI_TOKEN_URL=https://api.cnptia.embrapa.br/token
# AGROAPI_CULTURAS_URL=https://api.cnptia.embrapa.br/agritec/v1/culturas
